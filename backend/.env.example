# ==========================================
# VYBE Social Platform - Environment Config
# ==========================================

PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vybe_db
JWT_SECRET=vybe_super_secure_jwt_secret_key_2026_modern_social
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Motor en memoria (Fallback):
# - En desarrollo local: true (permite probar sin PostgreSQL levantado)
# - En producción (Vercel, Render, Railway): false (obliga a usar PostgreSQL real)
ENABLE_MEMORY_FALLBACK=true
